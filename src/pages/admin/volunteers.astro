---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Volunteer inbox" description="Admin: review submitted volunteer hours.">
  <section class="container-wide py-10 lg:py-14">
    <div class="max-w-5xl mx-auto">
      <div class="flex items-center justify-between gap-4 mb-2">
        <div>
          <div class="text-xs uppercase tracking-[0.18em] text-ink-500 font-semibold mb-2">Admin</div>
          <h1 class="font-serif text-3xl sm:text-4xl font-semibold tracking-tight">Volunteer inbox</h1>
        </div>
        <div class="flex items-center gap-2 text-xs">
          <button data-filter="pending"  class="vol-filter active">Pending</button>
          <button data-filter="approved" class="vol-filter">Approved</button>
          <button data-filter="rejected" class="vol-filter">Rejected</button>
          <button data-filter="all"      class="vol-filter">All</button>
        </div>
      </div>

      <nav class="flex items-center gap-3 text-xs text-ink-500 dark:text-ink-400 mb-8">
        <a href="/admin/requests" class="hover:text-accent-700 dark:hover:text-accent-400">Request inbox</a>
        <span class="text-ink-300 dark:text-ink-700">·</span>
        <span class="text-ink-700 dark:text-ink-200 font-semibold">Volunteer inbox</span>
      </nav>

      <div id="admin-gate" class="hidden surface rounded-2xl p-10 text-center">
        <h2 class="font-serif text-xl mb-2">Admins only</h2>
        <p class="text-ink-500 text-sm max-w-md mx-auto">
          You need an admin account to view volunteer submissions.
          <a href="/login" class="text-accent-700 dark:text-accent-400 hover:underline">Log in</a> or ask the site maintainer to promote your account.
        </p>
      </div>

      <div id="admin-offline" class="hidden surface rounded-2xl p-10 text-center">
        <h2 class="font-serif text-xl mb-2">Supabase not configured</h2>
        <p class="text-ink-500 text-sm max-w-md mx-auto">
          This page needs a Supabase backend. See <code class="text-accent-700 dark:text-accent-400">SUPABASE_SETUP.md</code> in the repo root.
        </p>
      </div>

      <div id="vol-loading" class="text-sm text-ink-500">Loading...</div>

      <div id="vol-summary" class="hidden grid sm:grid-cols-3 gap-3 mb-6">
        <div class="surface rounded-xl p-4">
          <div class="text-[11px] uppercase tracking-[0.14em] text-ink-500 font-semibold">Pending hours</div>
          <div class="font-mono text-2xl text-ink-900 dark:text-ink-50 mt-1" data-summary="pending">0</div>
        </div>
        <div class="surface rounded-xl p-4">
          <div class="text-[11px] uppercase tracking-[0.14em] text-ink-500 font-semibold">Approved hours</div>
          <div class="font-mono text-2xl text-ink-900 dark:text-ink-50 mt-1" data-summary="approved">0</div>
        </div>
        <div class="surface rounded-xl p-4">
          <div class="text-[11px] uppercase tracking-[0.14em] text-ink-500 font-semibold">Total submissions</div>
          <div class="font-mono text-2xl text-ink-900 dark:text-ink-50 mt-1" data-summary="total">0</div>
        </div>
      </div>

      <div id="vol-empty" class="hidden surface rounded-2xl p-10 text-center text-sm text-ink-500">
        No submissions in this view.
      </div>

      <ul id="vol-list" class="hidden space-y-3"></ul>
    </div>
  </section>
</BaseLayout>

<style>
  .vol-filter {
    @apply px-3 py-1 rounded-full text-xs font-medium bg-ink-100 text-ink-600 dark:bg-ink-800 dark:text-ink-300;
    @apply hover:bg-ink-200 dark:hover:bg-ink-700 transition-colors;
  }
  .vol-filter.active {
    @apply bg-accent-700 text-white dark:bg-accent-600;
  }
  .vol-chip {
    @apply inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] uppercase tracking-[0.14em] font-semibold;
  }
</style>

<script>
  import { currentUser, isCloudMode, onAuthChange } from '../../lib/auth';
  import { supabase } from '../../lib/supabase';

  type Row = {
    id: string;
    created_at: string;
    user_id: string | null;
    name: string | null;
    email: string | null;
    contact_email: string | null;
    guide_slug: string | null;
    grade: string | null;
    hours: number | null;
    note_fix: string | null;
    note_good: string | null;
    note_bad: string | null;
    status: 'pending' | 'approved' | 'rejected';
  };

  const STATUS_COLORS: Record<string, string> = {
    pending:  'bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-200',
    approved: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-200',
    rejected: 'bg-accent-100 text-accent-800 dark:bg-accent-900/40 dark:text-accent-200',
  };

  const fmt = (d: string) => new Date(d).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c as any] as string));

  const setup = () => {
    const gate = document.getElementById('admin-gate')!;
    const offline = document.getElementById('admin-offline')!;
    const loading = document.getElementById('vol-loading')!;
    const summary = document.getElementById('vol-summary')!;
    const empty = document.getElementById('vol-empty')!;
    const list = document.getElementById('vol-list')!;

    if (!isCloudMode()) {
      loading.classList.add('hidden');
      offline.classList.remove('hidden');
      return;
    }

    const me = currentUser();
    if (!me?.isAdmin) {
      loading.classList.add('hidden');
      gate.classList.remove('hidden');
      return;
    }
    gate.classList.add('hidden');

    let current: Row[] = [];
    let filter: string = 'pending';

    const updateSummary = () => {
      summary.classList.remove('hidden');
      const sumHours = (status: Row['status']) =>
        current.filter((r) => r.status === status).reduce((acc, r) => acc + (r.hours ?? 0), 0);
      const totalEl = summary.querySelector('[data-summary="total"]') as HTMLElement | null;
      const pendingEl = summary.querySelector('[data-summary="pending"]') as HTMLElement | null;
      const approvedEl = summary.querySelector('[data-summary="approved"]') as HTMLElement | null;
      if (totalEl)    totalEl.textContent    = String(current.length);
      if (pendingEl)  pendingEl.textContent  = sumHours('pending').toFixed(1);
      if (approvedEl) approvedEl.textContent = sumHours('approved').toFixed(1);
    };

    const noteBlock = (label: string, value: string | null) => {
      if (!value) return '';
      return `
        <div>
          <div class="text-[10px] uppercase tracking-[0.14em] font-semibold text-ink-500 dark:text-ink-400 mb-1">${label}</div>
          <p class="text-sm text-ink-700 dark:text-ink-300 whitespace-pre-wrap leading-relaxed">${esc(value)}</p>
        </div>
      `;
    };

    const render = () => {
      const items = filter === 'all' ? current : current.filter((r) => r.status === filter);
      if (items.length === 0) {
        list.classList.add('hidden');
        empty.classList.remove('hidden');
        return;
      }
      empty.classList.add('hidden');
      list.classList.remove('hidden');
      list.innerHTML = items.map((r) => {
        const guideLink = r.guide_slug
          ? `<a href="/guides/${esc(r.guide_slug)}/" class="hover:underline text-accent-700 dark:text-accent-400 font-mono">${esc(r.guide_slug)}</a>`
          : '<span class="text-ink-400">(no guide)</span>';
        return `
        <li class="surface rounded-xl p-5" data-vol-id="${r.id}">
          <div class="flex items-start justify-between gap-3 mb-2 flex-wrap">
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="vol-chip ${STATUS_COLORS[r.status] ?? ''}">${r.status}</span>
                <span class="vol-chip bg-ink-100 text-ink-600 dark:bg-ink-800 dark:text-ink-300">${(r.hours ?? 0).toFixed(1)} hr</span>
                ${r.grade ? `<span class="vol-chip bg-ink-100 text-ink-600 dark:bg-ink-800 dark:text-ink-300">Grade ${esc(r.grade)}</span>` : ''}
              </div>
              <h3 class="font-serif text-lg font-semibold mt-2">
                ${r.name ? esc(r.name) : '<span class="text-ink-400">(no name)</span>'}
                <span class="text-ink-400 dark:text-ink-500 font-sans text-sm font-normal"> on ${guideLink}</span>
              </h3>
            </div>
            <div class="text-[11px] text-ink-500 whitespace-nowrap">${fmt(r.created_at)}</div>
          </div>

          <div class="text-xs text-ink-500 mb-3 flex flex-wrap gap-x-4 gap-y-1">
            ${r.email         ? `<span>School: <a class="text-accent-700 dark:text-accent-400 hover:underline" href="mailto:${esc(r.email)}">${esc(r.email)}</a></span>` : ''}
            ${r.contact_email && r.contact_email !== r.email ? `<span>Contact: <a class="text-accent-700 dark:text-accent-400 hover:underline" href="mailto:${esc(r.contact_email)}">${esc(r.contact_email)}</a></span>` : ''}
            ${r.user_id ? `<span class="font-mono text-[10px] text-ink-400">uid:${esc(r.user_id.slice(0, 8))}</span>` : ''}
          </div>

          <div class="space-y-3 mb-3">
            ${noteBlock('Something to fix', r.note_fix)}
            ${noteBlock('Something good',   r.note_good)}
            ${noteBlock('Something bad',    r.note_bad)}
          </div>

          <div class="flex flex-wrap items-center gap-2 pt-3 border-t border-ink-200 dark:border-ink-800 text-xs">
            <button data-set-status="approved" class="px-2.5 py-1 rounded-md bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-200 hover:bg-emerald-200 dark:hover:bg-emerald-900/60">Approve</button>
            <button data-set-status="rejected" class="px-2.5 py-1 rounded-md bg-accent-100 text-accent-800 dark:bg-accent-900/40 dark:text-accent-200 hover:bg-accent-200 dark:hover:bg-accent-900/60">Reject</button>
            <button data-set-status="pending"  class="px-2.5 py-1 rounded-md text-ink-500 hover:text-ink-900 dark:hover:text-ink-50">Reset to pending</button>
          </div>
        </li>
      `;}).join('');

      list.querySelectorAll<HTMLButtonElement>('[data-set-status]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const li = btn.closest('[data-vol-id]') as HTMLElement | null;
          if (!li) return;
          const id = li.dataset.volId!;
          const status = btn.dataset.setStatus!;
          btn.disabled = true;
          const sb = supabase();
          const { error } = await sb!.from('volunteer_signups').update({ status }).eq('id', id);
          btn.disabled = false;
          if (error) { alert(error.message); return; }
          current = current.map((r) => r.id === id ? { ...r, status: status as Row['status'] } : r);
          updateSummary();
          render();
        });
      });
    };

    const load = async () => {
      loading.classList.remove('hidden');
      const sb = supabase();
      const { data, error } = await sb!.from('volunteer_signups').select('*').order('created_at', { ascending: false });
      loading.classList.add('hidden');
      if (error) {
        empty.textContent = 'Error loading submissions: ' + error.message;
        empty.classList.remove('hidden');
        return;
      }
      current = (data ?? []) as Row[];
      updateSummary();
      render();
    };
    load();

    document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.vol-filter').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        filter = btn.dataset.filter!;
        render();
      });
    });

    onAuthChange((u) => {
      if (!u?.isAdmin) window.location.href = '/';
    });
  };
  setup();
  document.addEventListener('astro:after-swap', setup);
</script>

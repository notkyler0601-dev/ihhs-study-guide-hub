---
import BaseLayout from '../layouts/BaseLayout.astro';
import GuideCard from '../components/GuideCard.astro';
import { getCollection } from 'astro:content';

const allGuides = (await getCollection('guides', ({ data }) => !data.draft))
  .sort((a, b) => {
    // Coming-soon guides float to the TOP of the library so visitors
    // see what's about to ship before scrolling through the back catalog.
    if (a.data.comingSoon !== b.data.comingSoon) {
      return a.data.comingSoon ? -1 : 1;
    }
    return b.data.date.valueOf() - a.data.date.valueOf();
  });

const FINALS_LABEL = 'Finals';

// Finals guides are pulled out into their own headlined section at the top
// of the library. They are ALSO removed from the main grid below so they
// only appear once on the page.
const finalsGuides = allGuides.filter((g) => (g.data.categories ?? []).includes(FINALS_LABEL));
const restGuides = allGuides.filter((g) => !(g.data.categories ?? []).includes(FINALS_LABEL));

// Collect every subject label across primary + categories so the filter covers all of them.
// We deliberately exclude "Finals" from the subject filter chips because it now has its
// own dedicated section above the grid.
const subjectSet = new Set<string>();
for (const g of allGuides) {
  if (g.data.subject !== FINALS_LABEL) subjectSet.add(g.data.subject);
  for (const c of g.data.categories ?? []) {
    if (c !== FINALS_LABEL) subjectSet.add(c);
  }
}
const subjects = [...subjectSet].sort();
---

<BaseLayout title="Library" description="Every study guide in the IHHS Hub.">
  <section class="container-wide py-12 lg:py-16">
    <div class="max-w-3xl mb-10 stagger-fade">
      <div class="text-xs uppercase tracking-[0.18em] text-ink-500 font-semibold mb-3">Library</div>
      <h1 class="font-serif text-4xl sm:text-5xl font-semibold tracking-tight text-balance">
        Every guide in <span class="gradient-text">one place</span>
      </h1>
      <p class="mt-4 text-lg text-ink-600 dark:text-ink-300 leading-relaxed">
        {allGuides.length} guide{allGuides.length === 1 ? '' : 's'} across {subjects.length} subject{subjects.length === 1 ? '' : 's'}. Filter, search, dive in.
      </p>
    </div>

    {finalsGuides.length > 0 && (
      <section id="finals-section" class="mb-12">
        <div class="relative overflow-hidden rounded-3xl border-2 border-accent-700 dark:border-accent-600 bg-gradient-to-br from-accent-50 via-white to-white dark:from-accent-950/40 dark:via-ink-950 dark:to-ink-950 p-6 sm:p-8 mb-6">
          <div class="absolute -top-3 -right-3 rotate-12 bg-accent-700 dark:bg-accent-600 text-white text-[10px] font-mono font-bold tracking-[0.18em] px-4 py-1.5 rounded-bl-md shadow-lift">
            FINAL EXAMS
          </div>
          <div class="text-xs uppercase tracking-[0.18em] text-accent-700 dark:text-accent-400 font-semibold mb-2">Finals</div>
          <h2 class="font-serif text-3xl sm:text-4xl font-semibold tracking-tight text-balance mb-2">
            Cram for the <span class="gradient-text">big one</span>
          </h2>
          <p class="text-base text-ink-600 dark:text-ink-300 leading-relaxed max-w-2xl">
            {finalsGuides.length} guide{finalsGuides.length === 1 ? '' : 's'} built specifically for end-of-semester finals: comprehensive coverage, mock tests, and study aids you can drill the night before.
          </p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {finalsGuides.map((g) => (
            <GuideCard
              href={`/guides/${g.id.replace(/\.(md|mdx)$/, '')}`}
              title={g.data.title}
              description={g.data.description}
              subject={g.data.subject}
              categories={g.data.categories}
              estimatedTime={g.data.estimatedTime}
              tags={g.data.tags}
              date={g.data.date}
              comingSoon={g.data.comingSoon}
            />
          ))}
        </div>
      </section>
    )}

    {finalsGuides.length > 0 && (
      <div class="flex items-center gap-3 mb-8">
        <div class="flex-1 h-px bg-ink-200 dark:bg-ink-800"></div>
        <div class="text-[11px] uppercase tracking-[0.18em] font-semibold text-ink-500">All other guides</div>
        <div class="flex-1 h-px bg-ink-200 dark:bg-ink-800"></div>
      </div>
    )}

    <div class="surface rounded-2xl p-5 mb-8">
      <div class="flex flex-col gap-4">
        <div>
          <input
            id="lib-search"
            type="text"
            placeholder="Search by title, topic, or tag..."
            class="w-full bg-transparent border-b border-ink-200 dark:border-ink-800 px-1 py-2 text-base placeholder-ink-400 focus:outline-none focus:border-accent-500"
          />
        </div>
        <div class="flex flex-wrap gap-3 items-center text-sm">
          <span class="text-xs uppercase tracking-[0.14em] font-semibold text-ink-500 mr-1">Subject:</span>
          <button data-filter-subject="all" class="filter-btn active px-3 py-1 rounded-full text-xs font-medium transition-colors">All</button>
          {subjects.map((s) => (
            <button data-filter-subject={s} class="filter-btn px-3 py-1 rounded-full text-xs font-medium transition-colors">{s}</button>
          ))}
        </div>
      </div>
    </div>

    <div id="lib-grid" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {restGuides.map((g) => (
        <div data-guide
          data-subjects={[g.data.subject, ...(g.data.categories ?? [])].join('|')}
          data-search={(g.data.title + ' ' + g.data.description + ' ' + g.data.tags.join(' ') + ' ' + [g.data.subject, ...(g.data.categories ?? [])].join(' ')).toLowerCase()}
        >
          <GuideCard
            href={`/guides/${g.id.replace(/\.(md|mdx)$/, '')}`}
            title={g.data.title}
            description={g.data.description}
            subject={g.data.subject}
            categories={g.data.categories}
            estimatedTime={g.data.estimatedTime}
            tags={g.data.tags}
            date={g.data.date}
            comingSoon={g.data.comingSoon}
          />
        </div>
      ))}
    </div>

    <div id="lib-empty" class="hidden surface rounded-2xl p-12 text-center mt-6">
      <div class="font-serif text-xl mb-1">No guides match these filters</div>
      <p class="text-sm text-ink-500">Try clearing some filters above.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .filter-btn {
    @apply bg-ink-100 text-ink-600 dark:bg-ink-800 dark:text-ink-300 hover:bg-ink-200 dark:hover:bg-ink-700;
  }
  .filter-btn.active {
    @apply bg-accent-700 text-white dark:bg-accent-600;
  }
</style>

<script is:inline>
  const setup = () => {
    const search = document.getElementById('lib-search');
    if (!search) return;
    let activeSubject = 'all';
    let query = '';

    const apply = () => {
      const cards = document.querySelectorAll('[data-guide]');
      let visible = 0;
      cards.forEach((c) => {
        const cardSubjects = (c.dataset.subjects || '').split('|');
        const subjectMatch = activeSubject === 'all' || cardSubjects.includes(activeSubject);
        const queryMatch = !query || c.dataset.search.includes(query);
        const show = subjectMatch && queryMatch;
        c.classList.toggle('hidden', !show);
        if (show) visible++;
      });
      document.getElementById('lib-empty').classList.toggle('hidden', visible !== 0);
    };

    document.querySelectorAll('[data-filter-subject]').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.filter-btn').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        activeSubject = btn.dataset.filterSubject;
        apply();
      });
    });
    search.addEventListener('input', (e) => { query = e.target.value.trim().toLowerCase(); apply(); });
  };
  setup();
  document.addEventListener('astro:after-swap', setup);
</script>

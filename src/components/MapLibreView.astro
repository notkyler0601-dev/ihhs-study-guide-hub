---
// MapLibre GL: free open-source vector map (Mapbox GL fork). Zero billing.
// Loaded lazily; tiles served by MapTiler/Stadia/etc free demo styles.
//
// Usage in MDX:
//   <MapLibreView
//     center={[2.35, 48.86]}
//     zoom={5}
//     markers={[
//       { lng: 2.35, lat: 48.86, label: 'Paris' },
//       { lng: -0.13, lat: 51.50, label: 'London' }
//     ]}
//   />
interface Marker { lng: number; lat: number; label?: string; description?: string; color?: string; }
interface Props {
  center?: [number, number];
  zoom?: number;
  height?: string;
  style?: string;
  markers?: Marker[];
  projection?: 'mercator' | 'globe';
}
const {
  center = [0, 20],
  zoom = 1.5,
  height = '420px',
  style = 'https://demotiles.maplibre.org/style.json',
  markers = [],
  projection = 'mercator',
} = Astro.props;
const id = 'maplibre-' + Math.random().toString(36).slice(2, 9);
const conf = JSON.stringify({ center, zoom, style, markers, projection });
---

<div class="not-prose my-6 surface rounded-xl overflow-hidden">
  <div
    id={id}
    data-maplibre-root
    data-maplibre-conf={conf}
    style={`width: 100%; height: ${height};`}
  ></div>
</div>

<style is:global>
  .ihhs-maplibre-popup .maplibregl-popup-content {
    border-radius: 10px;
    padding: 12px 14px 12px 14px;
    font-family: 'Inter', system-ui, sans-serif;
    box-shadow: 0 12px 32px rgba(0,0,0,0.18);
    max-width: 280px;
  }
  .ihhs-maplibre-popup .maplibregl-popup-content h4 {
    margin: 0 0 4px 0;
    font-family: 'Fraunces', Georgia, serif;
    font-size: 14px;
    font-weight: 600;
    color: #b91c1c;
  }
  .ihhs-maplibre-popup .maplibregl-popup-content p {
    margin: 0;
    font-size: 12.5px;
    line-height: 1.45;
    color: #27272a;
  }
  .dark .ihhs-maplibre-popup .maplibregl-popup-content { background: #18181b; color: #fafafa; }
  .dark .ihhs-maplibre-popup .maplibregl-popup-content p { color: #e4e4e7; }
  .dark .ihhs-maplibre-popup .maplibregl-popup-tip { border-top-color: #18181b; border-bottom-color: #18181b; }
</style>

<script>
  import { mountWhenVisible, isPerfMode, pauseWhenOffscreen } from '../lib/loadScript';

  const escape = (s: string) => String(s).replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'} as Record<string,string>)[c]);

  const initOne = async (el: HTMLElement) => {
    if (el.dataset.bound) return;
    el.dataset.bound = '1';
    let conf: any;
    try { conf = JSON.parse(el.dataset.maplibreConf || '{}'); } catch { return; }

    const maplibregl: any = (await import('maplibre-gl')).default;
    await import('maplibre-gl/dist/maplibre-gl.css');
    const map = new maplibregl.Map({
      container: el,
      style: conf.style,
      center: conf.center,
      zoom: conf.zoom,
      projection: conf.projection,
      attributionControl: { compact: true },
    });
    map.addControl(new maplibregl.NavigationControl({ showCompass: true }), 'top-right');
    map.on('load', () => {
      (conf.markers || []).forEach((m: any) => {
        const marker = new maplibregl.Marker({ color: m.color || '#b91c1c' })
          .setLngLat([m.lng, m.lat])
          .addTo(map);
        if (m.label || m.description) {
          const html =
            (m.label ? `<h4>${escape(m.label)}</h4>` : '') +
            (m.description ? `<p>${escape(m.description)}</p>` : '');
          const popup = new maplibregl.Popup({ offset: 14, className: 'ihhs-maplibre-popup', closeButton: true })
            .setHTML(html);
          marker.setPopup(popup);
        }
      });
    });

    // Pause MapLibre while offscreen. Setting the canvas to visibility:hidden
    // is enough for MapLibre to throttle its render loop.
    const canvas = el.querySelector<HTMLCanvasElement>('canvas');
    if (canvas) {
      pauseWhenOffscreen(el, {
        play: () => { canvas.style.visibility = ''; map.resize(); },
        pause: () => { canvas.style.visibility = 'hidden'; },
      });
    }
    // Perf mode: nothing to set on MapLibre's pixel ratio API directly, but
    // we can drop pitch to keep the simpler 2D projection.
    if (isPerfMode()) {
      try { map.setMaxPitch(0); } catch (_) {}
    }
  };

  mountWhenVisible('[data-maplibre-root]:not([data-bound])', (roots) => roots.forEach(initOne));
</script>

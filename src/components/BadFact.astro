---
// Misconception callout. Looks like a citation box but contains a
// commonly-believed-but-wrong claim, so the reader can mentally
// flag it and not parrot it back on a test.
//
// Usage:
//   <BadFact source="every confused student ever" certainty="0%">
//     The Lusitania pulled the US into WWI.
//   </BadFact>
interface Props {
  source?: string;
  certainty?: string;
  title?: string;
}
const { source = 'every confused student ever', certainty = '0%', title = 'Common misconception' } = Astro.props;
---

<aside class="not-prose my-6 rounded-xl border-2 border-accent-400 dark:border-accent-600 bg-accent-50 dark:bg-accent-950/40 p-4 shadow-soft relative overflow-hidden">
  <div class="absolute -top-1 -right-1 rotate-12 bg-accent-700 dark:bg-accent-600 text-white text-[10px] font-mono font-bold tracking-widest px-3 py-1 rounded-bl-md shadow-lift">
    ✗ {certainty} TRUE
  </div>
  <div class="flex items-center gap-2 text-[11px] uppercase tracking-[0.16em] font-bold text-accent-800 dark:text-accent-200 mb-2">
    <span class="text-base leading-none">⚠</span>
    <span>{title}</span>
  </div>
  <div class="text-[1.05rem] leading-relaxed text-ink-900 dark:text-ink-50 font-medium">
    <slot />
  </div>
  <p class="mt-3 text-[11px] italic text-accent-700 dark:text-accent-300">
    Source: {source}
  </p>
</aside>

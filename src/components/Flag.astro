---
// Country flag pictogram. Inline SVG for ~30 historical-Europe-relevant flags
// plus a Unicode regional-indicator emoji fallback for unknown codes. Used
// inline next to country names ("Germany + Austria-Hungary"), inside
// NetworkGraph alliance webs, and in MatchPairs leader-to-country puzzles.
//
// Special codes:
//   SU  = Soviet Union (red field with hand-drawn hammer-and-sickle).
//   AH  = Austria-Hungary (red-white-red horizontal tricolor, simplified).
//
// Examples:
//   <Flag code="DE" />
//   <Flag code="DE" size="2em" title="Germany" />
//   <Flag code="GB" inline />
interface Props {
  code: string;
  size?: string;
  title?: string;
  inline?: boolean;
  class?: string;
}
const { code, size = '1.25em', title, inline = false, class: extraClass = '' } = Astro.props;

const upperCode = (code || '').toUpperCase();

// Country-name lookup. Covers the historical-Europe set plus a few extras
// the Modern European History guide reaches for.
const NAMES: Record<string, string> = {
  DE: 'Germany',
  GB: 'United Kingdom',
  US: 'United States',
  FR: 'France',
  IT: 'Italy',
  JP: 'Japan',
  RU: 'Russia',
  SU: 'Soviet Union',
  CN: 'China',
  AT: 'Austria',
  AH: 'Austria-Hungary',
  PL: 'Poland',
  CZ: 'Czechoslovakia',
  BE: 'Belgium',
  NL: 'Netherlands',
  ES: 'Spain',
  PT: 'Portugal',
  GR: 'Greece',
  RO: 'Romania',
  BG: 'Bulgaria',
  RS: 'Serbia',
  YU: 'Yugoslavia',
  TR: 'Turkey',
  IR: 'Iran',
  IN: 'India',
  EG: 'Egypt',
  CU: 'Cuba',
  VN: 'Vietnam',
  KP: 'North Korea',
  KR: 'South Korea',
  HU: 'Hungary',
  CH: 'Switzerland',
  SE: 'Sweden',
  EE: 'Estonia',
  LV: 'Latvia',
  LT: 'Lithuania',
  FI: 'Finland',
  IQ: 'Iraq',
  SY: 'Syria',
  LB: 'Lebanon',
};

const displayName = title || NAMES[upperCode] || upperCode;

// Compute Unicode regional-indicator emoji as a fallback. For two-letter
// ISO codes only. "DE" becomes regional-indicator-D + regional-indicator-E.
const emojiFallback = (() => {
  if (upperCode.length !== 2) return '';
  const a = upperCode.charCodeAt(0);
  const b = upperCode.charCodeAt(1);
  if (a < 65 || a > 90 || b < 65 || b > 90) return '';
  return String.fromCodePoint(0x1f1e6 + (a - 65), 0x1f1e6 + (b - 65));
})();

// Hand-built SVG flag library. Each entry returns the inner SVG markup
// drawn on a 60 by 40 viewBox (3:2 aspect, matches most modern flags).
// Color palette is deliberately bright; flags should read at small sizes.
const FLAGS: Record<string, string> = {
  // Germany: black, red, gold horizontal tricolor.
  DE: `<rect width="60" height="40" fill="#000"/><rect y="13.33" width="60" height="13.33" fill="#dd0000"/><rect y="26.67" width="60" height="13.33" fill="#ffce00"/>`,
  // France: blue, white, red vertical tricolor.
  FR: `<rect width="60" height="40" fill="#fff"/><rect width="20" height="40" fill="#0055a4"/><rect x="40" width="20" height="40" fill="#ef4135"/>`,
  // Italy: green, white, red vertical tricolor.
  IT: `<rect width="60" height="40" fill="#fff"/><rect width="20" height="40" fill="#009246"/><rect x="40" width="20" height="40" fill="#ce2b37"/>`,
  // Belgium: black, yellow, red vertical tricolor.
  BE: `<rect width="60" height="40" fill="#000"/><rect x="20" width="20" height="40" fill="#fae042"/><rect x="40" width="20" height="40" fill="#ed2939"/>`,
  // Netherlands: red, white, blue horizontal tricolor.
  NL: `<rect width="60" height="40" fill="#fff"/><rect width="60" height="13.33" fill="#ae1c28"/><rect y="26.67" width="60" height="13.33" fill="#21468b"/>`,
  // Spain: red-yellow-red horizontal bands (yellow band is double height).
  ES: `<rect width="60" height="40" fill="#aa151b"/><rect y="10" width="60" height="20" fill="#f1bf00"/>`,
  // Portugal: green-red bicolor with simplified shield placeholder.
  PT: `<rect width="60" height="40" fill="#da291c"/><rect width="24" height="40" fill="#006233"/><circle cx="24" cy="20" r="5" fill="#fff" stroke="#ffd200" stroke-width="1.2"/>`,
  // Greece: blue and white horizontal stripes with canton cross.
  GR: `<rect width="60" height="40" fill="#fff"/><rect y="0" width="60" height="4.44" fill="#0d5eaf"/><rect y="8.89" width="60" height="4.44" fill="#0d5eaf"/><rect y="17.78" width="60" height="4.44" fill="#0d5eaf"/><rect y="26.67" width="60" height="4.44" fill="#0d5eaf"/><rect y="35.56" width="60" height="4.44" fill="#0d5eaf"/><rect width="22.22" height="22.22" fill="#0d5eaf"/><rect x="8.89" y="0" width="4.44" height="22.22" fill="#fff"/><rect y="8.89" width="22.22" height="4.44" fill="#fff"/>`,
  // Romania: blue, yellow, red vertical tricolor.
  RO: `<rect width="60" height="40" fill="#fff"/><rect width="20" height="40" fill="#002b7f"/><rect x="20" width="20" height="40" fill="#fcd116"/><rect x="40" width="20" height="40" fill="#ce1126"/>`,
  // Bulgaria: white, green, red horizontal tricolor.
  BG: `<rect width="60" height="40" fill="#fff"/><rect y="13.33" width="60" height="13.33" fill="#00966e"/><rect y="26.67" width="60" height="13.33" fill="#d62612"/>`,
  // Hungary: red, white, green horizontal tricolor.
  HU: `<rect width="60" height="40" fill="#fff"/><rect width="60" height="13.33" fill="#ce2939"/><rect y="26.67" width="60" height="13.33" fill="#477050"/>`,
  // Austria: red, white, red horizontal tricolor.
  AT: `<rect width="60" height="40" fill="#ed2939"/><rect y="13.33" width="60" height="13.33" fill="#fff"/>`,
  // Austria-Hungary: simplified dual-monarchy flag, red over white over red,
  // matched on the AT pattern. The historical naval flag was more complex,
  // but for a small pictogram the tricolor reads instantly.
  AH: `<rect width="60" height="40" fill="#ed2939"/><rect y="13.33" width="60" height="13.33" fill="#fff"/>`,
  // Switzerland: red field with white cross. Square-ish but rendered 3:2 here.
  CH: `<rect width="60" height="40" fill="#da291c"/><rect x="25" y="8" width="10" height="24" fill="#fff"/><rect x="18" y="15" width="24" height="10" fill="#fff"/>`,
  // Sweden: blue field with yellow Nordic cross.
  SE: `<rect width="60" height="40" fill="#005bac"/><rect x="18" width="6" height="40" fill="#fecc02"/><rect y="17" width="60" height="6" fill="#fecc02"/>`,
  // Poland: white over red horizontal bicolor.
  PL: `<rect width="60" height="40" fill="#fff"/><rect y="20" width="60" height="20" fill="#dc143c"/>`,
  // Czechoslovakia / Czech Republic: white over red with blue triangular hoist.
  CZ: `<rect width="60" height="40" fill="#fff"/><rect y="20" width="60" height="20" fill="#d7141a"/><polygon points="0,0 30,20 0,40" fill="#11457e"/>`,
  // United Kingdom: simplified Union Jack (red and white crosses on blue).
  GB: `<rect width="60" height="40" fill="#012169"/><path d="M0,0 L60,40 M60,0 L0,40" stroke="#fff" stroke-width="6"/><path d="M0,0 L60,40 M60,0 L0,40" stroke="#c8102e" stroke-width="2.4"/><rect x="26" width="8" height="40" fill="#fff"/><rect y="16" width="60" height="8" fill="#fff"/><rect x="28" width="4" height="40" fill="#c8102e"/><rect y="18" width="60" height="4" fill="#c8102e"/>`,
  // United States: 13 stripes, simplified blue canton with a few star dots.
  US: `<rect width="60" height="40" fill="#fff"/><rect y="0" width="60" height="3.08" fill="#b22234"/><rect y="6.15" width="60" height="3.08" fill="#b22234"/><rect y="12.31" width="60" height="3.08" fill="#b22234"/><rect y="18.46" width="60" height="3.08" fill="#b22234"/><rect y="24.62" width="60" height="3.08" fill="#b22234"/><rect y="30.77" width="60" height="3.08" fill="#b22234"/><rect y="36.92" width="60" height="3.08" fill="#b22234"/><rect width="24" height="21.54" fill="#3c3b6e"/><g fill="#fff"><circle cx="4" cy="3" r="0.9"/><circle cx="10" cy="3" r="0.9"/><circle cx="16" cy="3" r="0.9"/><circle cx="22" cy="3" r="0.9"/><circle cx="7" cy="7" r="0.9"/><circle cx="13" cy="7" r="0.9"/><circle cx="19" cy="7" r="0.9"/><circle cx="4" cy="11" r="0.9"/><circle cx="10" cy="11" r="0.9"/><circle cx="16" cy="11" r="0.9"/><circle cx="22" cy="11" r="0.9"/><circle cx="7" cy="15" r="0.9"/><circle cx="13" cy="15" r="0.9"/><circle cx="19" cy="15" r="0.9"/><circle cx="4" cy="19" r="0.9"/><circle cx="10" cy="19" r="0.9"/><circle cx="16" cy="19" r="0.9"/><circle cx="22" cy="19" r="0.9"/></g>`,
  // Russia (modern): white, blue, red horizontal tricolor.
  RU: `<rect width="60" height="40" fill="#fff"/><rect y="13.33" width="60" height="13.33" fill="#0039a6"/><rect y="26.67" width="60" height="13.33" fill="#d52b1e"/>`,
  // Soviet Union: red field with hand-drawn hammer-and-sickle in gold.
  SU: `<rect width="60" height="40" fill="#cc0000"/><g fill="#ffd700" stroke="#ffd700" stroke-width="0.8" stroke-linecap="round" transform="translate(13,9)"><path d="M2,8 L18,2 L19,5 L3,11 Z"/><path d="M16,1 L20,5" stroke-width="2"/><path d="M5,4 C2,8 2,14 6,17 L8,15 C5,13 5,9 7,6 Z"/><circle cx="6.5" cy="2.5" r="2.2" fill="none" stroke-width="1.6"/><polygon points="3,2 5,7 0,4 6,4 1,7" stroke="none"/></g>`,
  // China: red field with five gold stars (large + four small around).
  CN: `<rect width="60" height="40" fill="#de2910"/><g fill="#ffde00"><polygon points="12,6 13.7,11 19,11 14.6,14 16.3,19 12,16 7.7,19 9.4,14 5,11 10.3,11"/><polygon points="22,3 22.6,4.5 24.2,4.5 22.9,5.5 23.4,7 22,6.1 20.6,7 21.1,5.5 19.8,4.5 21.4,4.5"/><polygon points="26,7 26.6,8.5 28.2,8.5 26.9,9.5 27.4,11 26,10.1 24.6,11 25.1,9.5 23.8,8.5 25.4,8.5"/><polygon points="26,13 26.6,14.5 28.2,14.5 26.9,15.5 27.4,17 26,16.1 24.6,17 25.1,15.5 23.8,14.5 25.4,14.5"/><polygon points="22,17 22.6,18.5 24.2,18.5 22.9,19.5 23.4,21 22,20.1 20.6,21 21.1,19.5 19.8,18.5 21.4,18.5"/></g>`,
  // Japan: white field with red disk.
  JP: `<rect width="60" height="40" fill="#fff"/><circle cx="30" cy="20" r="12" fill="#bc002d"/>`,
  // Turkey: red field with white crescent and star.
  TR: `<rect width="60" height="40" fill="#e30a17"/><circle cx="22" cy="20" r="9" fill="#fff"/><circle cx="24.5" cy="20" r="7.5" fill="#e30a17"/><polygon points="34,20 36.4,21.6 35.5,18.8 37.9,17.2 34.9,17.2 34,14.4 33.1,17.2 30.1,17.2 32.5,18.8 31.6,21.6" fill="#fff"/>`,
  // Iran: green, white, red horizontal tricolor (simplified).
  IR: `<rect width="60" height="40" fill="#fff"/><rect width="60" height="13.33" fill="#239f40"/><rect y="26.67" width="60" height="13.33" fill="#da0000"/>`,
  // India: saffron, white, green horizontal tricolor with blue chakra dot.
  IN: `<rect width="60" height="40" fill="#fff"/><rect width="60" height="13.33" fill="#ff9933"/><rect y="26.67" width="60" height="13.33" fill="#138808"/><circle cx="30" cy="20" r="3.6" fill="none" stroke="#000080" stroke-width="0.8"/>`,
  // Egypt: red, white, black horizontal tricolor (simplified, no eagle).
  EG: `<rect width="60" height="40" fill="#fff"/><rect width="60" height="13.33" fill="#ce1126"/><rect y="26.67" width="60" height="13.33" fill="#000"/>`,
  // Cuba: blue and white stripes with red triangular hoist + white star.
  CU: `<rect width="60" height="40" fill="#fff"/><rect y="0" width="60" height="8" fill="#002a8f"/><rect y="16" width="60" height="8" fill="#002a8f"/><rect y="32" width="60" height="8" fill="#002a8f"/><polygon points="0,0 26,20 0,40" fill="#cf142b"/><polygon points="9,20 11.4,17 10.5,13.6 13.5,15.4 16.5,13.6 15.6,17 18,20 14.5,20 13.5,23 12.5,20" fill="#fff"/>`,
  // Vietnam: red field with yellow star.
  VN: `<rect width="60" height="40" fill="#da251d"/><polygon points="30,10 33.8,21.6 46,21.6 36.1,28.8 39.9,40.4 30,33.2 20.1,40.4 23.9,28.8 14,21.6 26.2,21.6" fill="#ffff00"/>`,
  // North Korea: blue-red-blue horizontal stripes with white circle + red star.
  KP: `<rect width="60" height="40" fill="#024fa2"/><rect y="6" width="60" height="28" fill="#ed1c27"/><rect y="6" width="60" height="2" fill="#fff"/><rect y="32" width="60" height="2" fill="#fff"/><circle cx="22" cy="20" r="6" fill="#fff"/><polygon points="22,15 23.5,18.6 27.5,18.6 24.2,21 25.6,24.6 22,22.4 18.4,24.6 19.8,21 16.5,18.6 20.5,18.6" fill="#ed1c27"/>`,
  // South Korea: white field with red-and-blue taegeuk and four trigrams (simplified).
  KR: `<rect width="60" height="40" fill="#fff"/><circle cx="30" cy="20" r="9" fill="#cd2e3a"/><path d="M30,11 A9,9 0 0 0 30,29 A4.5,4.5 0 0 1 30,20 A4.5,4.5 0 0 0 30,11 Z" fill="#0047a0"/><g fill="#000" stroke="none"><rect x="9" y="8" width="6" height="1.4"/><rect x="9" y="11" width="6" height="1.4"/><rect x="9" y="14" width="6" height="1.4"/><rect x="45" y="8" width="2.4" height="1.4"/><rect x="48.4" y="8" width="2.4" height="1.4"/><rect x="45" y="11" width="2.4" height="1.4"/><rect x="48.4" y="11" width="2.4" height="1.4"/><rect x="45" y="14" width="6" height="1.4"/><rect x="9" y="25" width="2.4" height="1.4"/><rect x="12.6" y="25" width="2.4" height="1.4"/><rect x="9" y="28" width="6" height="1.4"/><rect x="9" y="31" width="2.4" height="1.4"/><rect x="12.6" y="31" width="2.4" height="1.4"/><rect x="45" y="25" width="2.4" height="1.4"/><rect x="48.4" y="25" width="2.4" height="1.4"/><rect x="45" y="28" width="2.4" height="1.4"/><rect x="48.4" y="28" width="2.4" height="1.4"/><rect x="45" y="31" width="2.4" height="1.4"/><rect x="48.4" y="31" width="2.4" height="1.4"/></g>`,
  // Serbia: red, blue, white horizontal tricolor (modern, simplified).
  RS: `<rect width="60" height="40" fill="#fff"/><rect width="60" height="13.33" fill="#c6363c"/><rect y="13.33" width="60" height="13.33" fill="#0c4076"/>`,
  // Yugoslavia (1946 to 1992): blue, white, red horizontal tricolor with red star.
  YU: `<rect width="60" height="40" fill="#fff"/><rect width="60" height="13.33" fill="#003893"/><rect y="26.67" width="60" height="13.33" fill="#cf142b"/><polygon points="30,10 31.7,15 37,15 32.6,18 34.3,23 30,20 25.7,23 27.4,18 23,15 28.3,15" fill="#cf142b" stroke="#ffd700" stroke-width="0.8"/>`,
  // Estonia: blue, black, white horizontal tricolor.
  EE: `<rect width="60" height="40" fill="#0072ce"/><rect y="13.33" width="60" height="13.33" fill="#000"/><rect y="26.67" width="60" height="13.33" fill="#fff"/>`,
  // Latvia: maroon field with a horizontal white band in the middle (band is half-height).
  LV: `<rect width="60" height="40" fill="#9e3039"/><rect y="16" width="60" height="8" fill="#fff"/>`,
  // Lithuania: yellow, green, red horizontal tricolor.
  LT: `<rect width="60" height="40" fill="#fdb913"/><rect y="13.33" width="60" height="13.33" fill="#006a44"/><rect y="26.67" width="60" height="13.33" fill="#c1272d"/>`,
  // Finland: white field with blue Nordic cross.
  FI: `<rect width="60" height="40" fill="#fff"/><rect x="18" width="6" height="40" fill="#003580"/><rect y="17" width="60" height="6" fill="#003580"/>`,
  // Iraq (1991-2008 era, recognizable): red, white, black tricolor with three green stars.
  IQ: `<rect width="60" height="40" fill="#fff"/><rect width="60" height="13.33" fill="#ce1126"/><rect y="26.67" width="60" height="13.33" fill="#000"/><g fill="#007a3d"><polygon points="20,17 20.9,19.3 23.3,19.3 21.4,20.8 22.1,23.1 20,21.6 17.9,23.1 18.6,20.8 16.7,19.3 19.1,19.3"/><polygon points="30,17 30.9,19.3 33.3,19.3 31.4,20.8 32.1,23.1 30,21.6 27.9,23.1 28.6,20.8 26.7,19.3 29.1,19.3"/><polygon points="40,17 40.9,19.3 43.3,19.3 41.4,20.8 42.1,23.1 40,21.6 37.9,23.1 38.6,20.8 36.7,19.3 39.1,19.3"/></g>`,
  // Syria (1980-2024 era): red, white, black horizontal tricolor with two green stars in the middle band.
  SY: `<rect width="60" height="40" fill="#fff"/><rect width="60" height="13.33" fill="#ce1126"/><rect y="26.67" width="60" height="13.33" fill="#000"/><g fill="#007a3d"><polygon points="22,17 22.9,19.3 25.3,19.3 23.4,20.8 24.1,23.1 22,21.6 19.9,23.1 20.6,20.8 18.7,19.3 21.1,19.3"/><polygon points="38,17 38.9,19.3 41.3,19.3 39.4,20.8 40.1,23.1 38,21.6 35.9,23.1 36.6,20.8 34.7,19.3 37.1,19.3"/></g>`,
  // Lebanon: red horizontal stripes top and bottom, white middle (double-height) with stylized green cedar.
  LB: `<rect width="60" height="40" fill="#fff"/><rect width="60" height="10" fill="#ed1c24"/><rect y="30" width="60" height="10" fill="#ed1c24"/><g fill="#007a3d" transform="translate(30,20)"><polygon points="0,-7 -2,-3 2,-3"/><polygon points="0,-5 -4,-1 4,-1"/><polygon points="0,-3 -5,2 5,2"/><polygon points="0,-1 -6,5 6,5"/><rect x="-1" y="5" width="2" height="2"/></g>`,
};

const svgInner = FLAGS[upperCode];
const hasSvg = Boolean(svgInner);

const wrapperClass = inline
  ? `inline-flex items-center align-text-bottom shrink-0 ${extraClass}`
  : `inline-flex flex-col items-center gap-1 ${extraClass}`;

// Tiny border so flags with white edges (Japan, Poland) stay legible on
// both light and dark page backgrounds.
const flagBoxClass =
  'inline-block overflow-hidden rounded-sm ring-1 ring-black/40 dark:ring-white/40 leading-none';
---

<span
  class:list={['not-prose', wrapperClass]}
  data-flag
  data-code={upperCode}
  role="img"
  aria-label={displayName}
  title={displayName}
>
  {hasSvg ? (
    <span
      class={flagBoxClass}
      style={`width:${size};height:calc(${size} * 0.667);`}
      set:html={`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 60 40" preserveAspectRatio="xMidYMid slice" width="100%" height="100%">${svgInner}</svg>`}
    />
  ) : (
    <span
      class={flagBoxClass}
      style={`width:${size};height:calc(${size} * 0.667);font-family:'Apple Color Emoji','Segoe UI Emoji','Segoe UI Symbol','Noto Color Emoji',sans-serif;font-size:calc(${size} * 0.9);display:inline-flex;align-items:center;justify-content:center;line-height:1;`}
    >
      {emojiFallback || upperCode}
    </span>
  )}
  {!inline && (
    <span class="text-[0.7rem] uppercase tracking-[0.08em] text-ink-700 dark:text-ink-300">
      {displayName}
    </span>
  )}
</span>

<script>
  // Mark instances ready for parity with the standard component pattern,
  // even though Flag is fully static. This keeps the lifecycle uniform with
  // sibling components (RoughViz, RoughNotation) and lets DOM-walking tools
  // identify which flags have been processed across SPA navigations.
  const init = () => {
    const flags = document.querySelectorAll<HTMLElement>('[data-flag]:not([data-ready])');
    if (flags.length === 0) return;
    flags.forEach((el) => {
      el.dataset.ready = '1';
    });
  };
  init();
  document.addEventListener('astro:after-swap', init);
</script>

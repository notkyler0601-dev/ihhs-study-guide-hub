---
import { ClientRouter } from 'astro:transitions';
import Analytics from '@vercel/analytics/astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CommandPalette from '../components/CommandPalette.astro';
import AuroraBackground from '../components/AuroraBackground.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  showAurora?: boolean;
}
const { title, description = 'Deep-dive interactive study guides built by IHHS students.', showAurora = true } = Astro.props;
const fullTitle = title === 'IHHS Study Guide Hub' ? title : `${title} · IHHS Study Guide Hub`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/ihhs-logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <script is:inline>
      // Default to light mode. Dark mode is opt-in via the theme toggle and
      // only kicks in if the user has explicitly selected it before.
      (() => {
        if (localStorage.getItem('theme') === 'dark') {
          document.documentElement.classList.add('dark');
        }
        // Apply persisted accessibility preferences before paint so there's
        // no flash of the wrong font.
        if (localStorage.getItem('a11y:dyslexia-font') === '1') {
          document.documentElement.classList.add('a11y-dyslexia-font');
        }
        if (localStorage.getItem('a11y:reduce-motion') === '1') {
          document.documentElement.classList.add('a11y-reduce-motion');
        }
        // Scroll restoration policy:
        //   - Disable browser auto-restore (it fights lazy components).
        //   - Save scroll position to sessionStorage continuously.
        //   - On load, restore to the saved Y (clamped to current document
        //     height) and keep restoring for ~2.5s while lazy components
        //     hydrate and the document grows.
        //   - GuideLoader sets `__ihhsWarmingUp` when it intends to handle
        //     scroll itself; the pin yields to it.
        if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
        const SCROLL_KEY = 'ihhs:scroll:' + location.pathname;
        var saveTimer = 0;
        window.addEventListener('scroll', function () {
          clearTimeout(saveTimer);
          saveTimer = setTimeout(function () {
            if (window.__ihhsSuppressSave) return;
            try { sessionStorage.setItem(SCROLL_KEY, String(window.scrollY)); } catch (_) {}
          }, 250);
        }, { passive: true });
        window.addEventListener('beforeunload', () => {
          if (window.__ihhsSuppressSave) return;
          try { sessionStorage.setItem(SCROLL_KEY, String(window.scrollY)); } catch (_) {}
        });
        if (!location.hash) {
          // Read where the user left off. Default to 0 if missing/invalid.
          var savedY = 0;
          try {
            var raw = sessionStorage.getItem(SCROLL_KEY);
            if (raw !== null) {
              var parsed = parseInt(raw, 10);
              if (!isNaN(parsed) && parsed >= 0) savedY = parsed;
            }
          } catch (_) {}

          window.__ihhsSuppressSave = true;
          var userScrolled = false;
          var stopPin = function () {
            userScrolled = true;
            window.__ihhsSuppressSave = false;
          };
          ['wheel','touchstart','keydown','mousedown','pointerdown'].forEach(function (e) {
            window.addEventListener(e, stopPin, { once: true, passive: true });
          });
          var startedAt = performance.now();
          var pinFrame = function () {
            // GuideLoader is in charge of scroll. Don't pin.
            if (window.__ihhsWarmingUp) {
              requestAnimationFrame(pinFrame);
              return;
            }
            if (userScrolled) return;
            // Re-clamp every frame: as lazy components hydrate the doc grows
            // and we can reach further down toward savedY.
            var maxScroll = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
            var target = Math.min(savedY, maxScroll);
            if (Math.abs(window.scrollY - target) > 1) {
              window.scrollTo(0, target);
            }
            if (performance.now() - startedAt < 2500) {
              requestAnimationFrame(pinFrame);
            } else {
              window.__ihhsSuppressSave = false;
            }
          };
          requestAnimationFrame(pinFrame);
        }
      })();
    </script>
    <!--
      Resume-where-you-left-off pill removed: scroll restore now happens
      automatically inside the GuideLoader overlay. If a guide includes
      <GuideLoader />, the loader warms the page and then jumps to the
      saved scroll position before fading out.
    -->
    <script type="speculationrules" is:inline set:html={JSON.stringify({
      prerender: [
        { where: { href_matches: '/guides/*' }, eagerness: 'moderate' },
        { where: { href_matches: '/dashboard' }, eagerness: 'moderate' },
        { where: { href_matches: '/library' }, eagerness: 'moderate' },
        { where: { href_matches: '/review' }, eagerness: 'moderate' }
      ],
      prefetch: [
        { where: { href_matches: '/*' }, eagerness: 'conservative' }
      ]
    })} />
    <ClientRouter />
    <Analytics />
  </head>
  <body class="min-h-screen flex flex-col">
    {showAurora && <AuroraBackground />}
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <CommandPalette />
  </body>
</html>
